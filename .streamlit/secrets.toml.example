# PlantCare AI - example secrets file
#
# HOW TO USE
# 1. Copy this file:  cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. Replace every placeholder below with your own real value.
# 3. Never commit .streamlit/secrets.toml (it is already ignored by .gitignore).
#
# On Streamlit Community Cloud, do NOT create this file.
# Paste the same keys into:  App  ->  Settings  ->  Secrets.

# Google AI Studio API key - https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"

# Twilio Console - https://console.twilio.com
TWILIO_ACCOUNT_SID = "your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token-here"

# Your WhatsApp sender number, including the whatsapp: prefix.
# Twilio WhatsApp sandbox sender: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# No content template is needed. The report is sent as a regular WhatsApp
# message, which Twilio only accepts while the recipient has an active
# user-initiated messaging window. For the sandbox, the recipient must send an
# inbound message to the sandbox number first.